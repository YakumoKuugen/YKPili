<!--
  Motion.axaml —— 动效 token
  移植自 BewlyCat variables.scss 的 Motion 区段。

  BewlyCat 原文强调：优先过渡具体属性而非 `transition: all`，避免布局跳动。
  这条约定在 Avalonia 中同样适用——Transitions 只声明需要动画的属性。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- ================= 时长 ================= -->
  <!-- bew-duration-fast: 150ms -->
  <sys:TimeSpan x:Key="DurationFast">0:0:0.15</sys:TimeSpan>
  <!-- bew-duration-normal: 200ms -->
  <sys:TimeSpan x:Key="DurationNormal">0:0:0.2</sys:TimeSpan>
  <!-- bew-duration-moderate: 300ms -->
  <sys:TimeSpan x:Key="DurationModerate">0:0:0.3</sys:TimeSpan>

  <!-- ================= 缓动曲线 ================= -->
  <!--
    BewlyCat 用 CSS cubic-bezier；Avalonia 的 SplineEasing 暴露 X1/Y1/X2/Y2，
    因此以下两条曲线是 1:1 精确对应，而非近似。
  -->
  <!-- bew-ease-standard: cubic-bezier(0.22, 0.61, 0.36, 1) -->
  <SplineEasing x:Key="EaseStandard" X1="0.22" Y1="0.61" X2="0.36" Y2="1" />
  <!-- bew-ease-emphasized: cubic-bezier(0.34, 1.3, 0.64, 1) —— 带轻微回弹，用于交互按压 -->
  <SplineEasing x:Key="EaseEmphasized" X1="0.34" Y1="1.3" X2="0.64" Y2="1" />
  <!-- bew-ease-out / bew-ease-in-out -->
  <CubicEaseOut x:Key="EaseOut" />
  <CubicEaseInOut x:Key="EaseInOut" />

</ResourceDictionary>
