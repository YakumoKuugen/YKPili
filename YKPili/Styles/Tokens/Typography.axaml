<!--
  Typography.axaml —— 排版阶
  移植自 BewlyCat variables.scss 的 Typography 区段。

  原文注释保留其设计意图：Body 与 Title 共用 15px 基准，
  层级差异由行高与字重承担，而不是靠堆叠字号。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================= 字体族 ================= -->
  <!--
    中文字体栈。原先该字符串在 HomeView.axaml.cs 与 VideoPlayerView.axaml 中各硬编码一份，
    此处统一为单一来源。
    注意：Avalonia.Fonts.Inter 只提供拉丁字形，且未在本字体栈中启用——
    Inter 不含 CJK，放在中文之前会导致中文回退到系统默认衬线体。
  -->
  <FontFamily x:Key="FontFamilyUi">PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Source Han Sans SC, sans-serif</FontFamily>
  <FontFamily x:Key="FontFamilyIcon">Segoe UI Symbol, Apple Symbols, Noto Sans Symbols, sans-serif</FontFamily>

  <!-- ================= 字号 ================= -->
  <!-- bew-font-size-caption: 12px -->
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <!-- bew-font-size-control: 13px -->
  <x:Double x:Key="FontSizeControl">13</x:Double>
  <!-- bew-font-size-body: 15px -->
  <x:Double x:Key="FontSizeBody">15</x:Double>
  <!-- bew-font-size-title: 15px -->
  <x:Double x:Key="FontSizeTitle">15</x:Double>
  <!-- bew-font-size-heading: 20px -->
  <x:Double x:Key="FontSizeHeading">20</x:Double>
  <!-- bew-font-size-display: 24px -->
  <x:Double x:Key="FontSizeDisplay">24</x:Double>
  <x:Double x:Key="FontSizeDataEmphasis">28</x:Double>
  <!-- bew-base-font-size -->
  <x:Double x:Key="FontSizeBase">15</x:Double>

  <!--
    两档「小字」。以前封面数据层（播放量 / 弹幕数 / 时长）与角标用的是散落的
    10px / 11px 魔法数，不在字号阶内，等于绕过令牌层。
    · FontSizeMicro 10   角标 / 严重度 chip（.sev）
    · FontSizeDataOverlay 11  封面数据层与状态标签（压在封面图上，配文字阴影）
  -->
  <x:Double x:Key="FontSizeMicro">10</x:Double>
  <x:Double x:Key="FontSizeDataOverlay">11</x:Double>

  <!-- ================= 行高 ================= -->
  <x:Double x:Key="LineHeightCaption">16</x:Double>
  <x:Double x:Key="LineHeightControl">18</x:Double>
  <x:Double x:Key="LineHeightBody">24</x:Double>
  <x:Double x:Key="LineHeightTitle">22</x:Double>
  <x:Double x:Key="LineHeightHeading">28</x:Double>
  <x:Double x:Key="LineHeightData">32</x:Double>

  <!-- ================= 字重 ================= -->
  <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
  <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
  <FontWeight x:Key="FontWeightSemibold">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

  <!-- ================= 图标尺寸 ================= -->
  <!-- bew-icon-size-{sm,md,lg,xl}: 16 / 20 / 24 / 32 -->
  <x:Double x:Key="IconSizeSm">16</x:Double>
  <x:Double x:Key="IconSizeMd">20</x:Double>
  <x:Double x:Key="IconSizeLg">24</x:Double>
  <x:Double x:Key="IconSizeXl">32</x:Double>

</ResourceDictionary>
