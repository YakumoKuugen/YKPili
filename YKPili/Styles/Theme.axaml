<!--
  Theme.axaml —— 设计 Token 合并入口

  层级结构：
    Theme.axaml          合并入口（本文件）
      └─ Tokens/
           Palette.axaml      品牌色、主题色、状态色（不随主题变化）
           Typography.axaml   字号、行高、字重、字体族
           Dimensions.axaml   圆角、间距、控件几何
           Motion.axaml       时长与缓动曲线
           Surfaces.axaml     语义表面（随亮暗变化）
           Shadows.axaml      阴影与玻璃边缘光（随亮暗变化）
      └─ Controls/
           FluentOverrides.axaml   覆盖 Fluent 主题资源键（按钮 / 滚动条外观）

  使用方式：视图中一律以 {DynamicResource <Key>} 引用。
  随主题变化的资源必须用 DynamicResource，否则切换亮暗主题时不会重新求值。

  【覆盖顺序】FluentOverrides 放在最后合并，确保同名键覆盖 Fluent 主题的默认值。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Palette.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Typography.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Dimensions.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Motion.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Surfaces.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Tokens/Shadows.axaml" />
    <ResourceInclude Source="avares://YKPili/Styles/Controls/FluentOverrides.axaml" />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
