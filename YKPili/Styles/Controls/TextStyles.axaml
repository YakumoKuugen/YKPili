<!--
  TextStyles.axaml —— 排版样式类

  对应 BewlyCat Typography 区段的设计意图：
  Body 与 Title 共用 15px 基准，层级差异由行高与字重承担。

  这里同时对全局 TextBlock 设置字体族，以统一中文字体栈——
  原先该字体栈在 HomeView.axaml.cs 与 VideoPlayerView.axaml 中各硬编码一份。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 全局默认：中文字体栈 + 主文字色 -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>

  <!-- ============ 语义层级 ============ -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightTitle}" />
    <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemibold}" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightHeading}" />
    <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeightData}" />
    <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}" />
  </Style>

  <!-- ============ 颜色修饰 ============ -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource TextQuaternary}" />
  </Style>

  <Style Selector="TextBlock.on-accent">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <!-- 主题色强调（用于链接、品牌文案） -->
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
  </Style>

</Styles>
