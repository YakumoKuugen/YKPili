<!--
  ScrollBarStyles.axaml —— 滚动条补充样式

  宽度、轨道与滑块配色已由 FluentOverrides.axaml 的资源键接管
  （ScrollBarSize / ScrollBarPanningThumbBackground / ScrollBarTrackFill 等）。
  这里只处理资源键覆盖不到的两件事：
    1. 隐藏滚动条两端的 Line 上下按钮（沿用项目原有行为）
    2. 把滑块从方角改为胶囊形
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 隐藏两端的 Line Up/Down 按钮 -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                   ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- 滑块改胶囊形，配合 6px 宽度形成细圆角条 -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
  </Style>

</Styles>
