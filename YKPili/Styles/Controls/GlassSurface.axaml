<!--
  GlassSurface.axaml —— 玻璃材质样式类

  【材质配方说明】
  BewlyCat 的真毛玻璃是 backdrop-filter: blur(20px) saturate(180%)。
  Avalonia 12 没有 backdrop-filter（Visual.Effect 只有阴影，无 BlurEffect），
  因此这里用四层叠加来复刻观感：

    1. 半透明填充（SurfaceElevated，含 BewlyCat 的 0.68 内容不透明度）
    2. 1px 半透明边框（BorderPopover，模拟玻璃断面的亮边）
    3. inset 白色高光（ShadowGlass* 中的 inset 段，勾出玻璃倒角）
    4. 外阴影定层次（ShadowGlass* 中的 outset 段）

  第 3 条是这套材质的关键——BewlyCat 自己也是用 inset 阴影"模仿"磨砂玻璃边缘的，
  所以这部分是精确移植而非近似。

  用法：
    <Border Classes="glass">...</Border>
    <Border Classes="glass elevated">...</Border>   悬浮层级
    <Border Classes="glass modal">...</Border>      对话框层级
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 玻璃面板（默认：中小面板） ============ -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderPopover}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowGlassCard}" />
  </Style>

  <!-- 悬浮层级：播放器浮层、下拉面板 -->
  <Style Selector="Border.glass.elevated">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowGlassElevated}" />
  </Style>

  <!-- 对话框层级：更强内发光 + 更大圆角 -->
  <Style Selector="Border.glass.modal">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowGlassModal}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ModalRadius}" />
  </Style>

  <!-- 大圆角变体 -->
  <Style Selector="Border.glass.round">
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadiusContinuous}" />
  </Style>

  <!-- 无边框变体：玻璃面板嵌套时避免出现双线 -->
  <Style Selector="Border.glass.flush">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    高频内容之上的变体：把填充提高到 0.92 不透明度。
    适用于叠加在视频网格、图片等复杂画面之上的面板（如播放器浮层）——
    BewlyCat 有 backdrop-filter 可以把背后内容糊掉，Avalonia 没有，
    若仍用 0.68 的默认不透明度，背后的画面会直接干扰面板内文字的阅读。
  -->
  <Style Selector="Border.glass.on-content">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedStrong}" />
  </Style>

  <!-- ============ 实心表面（需要完全遮挡底层时使用） ============ -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceContentSolid}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
  </Style>

  <Style Selector="Border.surface.alt">
    <Setter Property="Background" Value="{DynamicResource SurfaceContentAlt}" />
  </Style>

  <!-- ============ 分隔线 ============ -->
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

</Styles>
