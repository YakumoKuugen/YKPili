<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YKPili.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="YKPili.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <!-- 设计时 DataContext:便于在 IDE 预览时显示样式 -->
  <Design.DataContext>
    <vm:LoginViewModel />
  </Design.DataContext>

  <!--
    登录页布局:垂直居中的玻璃卡片。
    glass / modal 样式类的材质配方见 Styles/Controls/GlassSurface.axaml——
    半透明填充 + 1px 亮边 + inset 玻璃倒角 + 对话框级外阴影。
  -->
  <Border Classes="glass modal"
          Width="380"
          Padding="32,36"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

    <StackPanel Spacing="20">

      <!-- ===== 标题区 ===== -->
      <StackPanel Spacing="4">
        <TextBlock Text="Bilibili Login"
                   Classes="heading"
                   HorizontalAlignment="Center" />
        <TextBlock Text="扫码登录以同步你的推荐与收藏"
                   Classes="caption"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!--
        二维码区域:仅在轮询时可见。
        底色保留纯白——二维码需要足够对比度才能被扫描,
        因此这里不跟随主题变暗。
      -->
      <Border Width="220" Height="220"
              CornerRadius="{DynamicResource MediaRadius}"
              Background="White"
              IsVisible="{Binding IsPolling}"
              HorizontalAlignment="Center">
        <Image Source="{Binding QrCodeImage}"
               Width="200" Height="200" />
      </Border>

      <!-- 状态文本:展示扫码阶段提示 -->
      <TextBlock Text="{Binding StatusMessage}"
                 Classes="body muted"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />

      <!-- 登录按钮:主题色主操作 -->
      <Button Classes="accent large"
              Content="Login"
              Command="{Binding StartLoginCommand}"
              IsVisible="{Binding !IsPolling}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" />

      <!-- 取消按钮:次级样式 -->
      <Button Classes="large"
              Content="Cancel"
              Command="{Binding CancelLoginCommand}"
              IsVisible="{Binding IsPolling}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" />

    </StackPanel>
  </Border>
</UserControl>
