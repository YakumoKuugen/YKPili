<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YKPili.ViewModels"
             xmlns:views="using:YKPili.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="YKPili.Views.MainView"
             x:Name="Root"
             x:DataType="vm:MainViewModel">
  <!-- 设计时 DataContext -->
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <!--
    三层布局:
      - 登录页:未登录时显示
      - 首页:已登录时显示
      - 播放器:始终叠加在最上层,通过内部 IsVisible 控制实际显隐
  -->
  <Grid>
    <views:LoginView DataContext="{Binding Login}"
                     IsVisible="{Binding !#Root.DataContext.IsLoggedIn}" />
    <views:HomeView DataContext="{Binding Home}"
                    IsVisible="{Binding #Root.DataContext.IsLoggedIn}" />
    <views:VideoPlayerView DataContext="{Binding VideoPlayer}" />
  </Grid>
</UserControl>
