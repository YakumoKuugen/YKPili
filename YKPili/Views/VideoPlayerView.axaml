<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YKPili.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="YKPili.Views.VideoPlayerView"
             x:DataType="vm:VideoPlayerViewModel"
             IsVisible="{Binding IsVisible}"
             Focusable="True">

  <!--
    播放器局部样式。
    控制栏悬浮在画面上,必须自己在任何背景下都可读,因此这里的颜色**刻意不跟随亮暗主题**——
    与 B 站播放器一致:深色半透明底 + 白字,叠在明亮画面上也不至于看不清。

    视觉参照 BewlyCat(src/styles/adaptedStyles/common/videoPlayer.scss):
      · 悬浮层用半透明黑底 + 圆角 + 阴影
      · 过渡 150ms ease-out,作用在 opacity 上
      · 尺寸/圆角取自设计 token
  -->
  <UserControl.Styles>
    <!-- 控制栏按钮:透明底 + 白字,悬停时出现浅色底板 -->
    <Style Selector="Button.player">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.player:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.player:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFFFFFF" />
    </Style>

    <!-- 控制栏文字 -->
    <Style Selector="TextBlock.playerTime">
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 进度条:细条 + B 站蓝。隐藏叠加层后它是唯一保留的元素,所以对比度要足 -->
    <Style Selector="ProgressBar.player">
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
      <Setter Property="Foreground" Value="#00A1D6" />
      <Setter Property="Background" Value="#4DFFFFFF" />
    </Style>
    <Style Selector="ProgressBar.player /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="2" />
    </Style>
  </UserControl.Styles>

  <!--
    播放器布局:
      Overlay(全屏遮罩) - 整个浮层
      Panel(玻璃面板)
        - Title Bar: 顶部标题
        - Video Area: 视频区域,NativeControlHost 在代码后台插入
            悬浮控制层贴在视频区底部,由三部分组成:
              1. 渐变背景(随控制栏显隐)
              2. 按钮行:播放/暂停 · 时间 · 倍速 · 音量 · 全屏 · 关闭(随控制栏显隐)
              3. 进度条:**始终可见**,贴在画面最下方

    为什么能悬浮:
      MacNativeControlHost 在原生视图挂上视觉树后,会把它压到父视图最底层
      (见 MacNativeControlHost.SendToBack),因此 Avalonia 绘制的控制层位于视频之上。
      若把该调用去掉,视频会反过来盖住整个控制层。

    注意:
      Panel / VideoArea / Overlay / ControlBar 四个 x:Name 被 code-behind 引用。
  -->
  <Grid x:Name="Overlay"
        Background="{DynamicResource OverlayScrim}"
        IsVisible="{Binding IsVisible}">

    <Border x:Name="Panel"
            Classes="glass elevated on-content"
            Width="{DynamicResource PlayerPanelWidth}"
            Height="{DynamicResource PlayerPanelHeight}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <!-- 视频区占满面板,标题以悬浮方式叠在画面顶部 -->
      <Grid RowDefinitions="*,Auto">

        <!-- ===== 视频区域:NativeControlHost 会在代码后台被插入到 VideoSurface ===== -->
        <Panel Grid.Row="0"
               x:Name="VideoArea"
               Background="Transparent">

          <!--
            视频渲染区。
            用 Stretch + 底部留白(而不是 Top + Height),这样高度由父容器推导:
            Avalonia 的原生宿主在渲染区内部拉伸,若渲染区自身高度依赖内容,
            会出现"内容等父高度、父高度等内容"的塌陷(实测高度为 0)。
          -->
          <Panel x:Name="VideoSurface"
                 VerticalAlignment="Stretch"
                 Margin="0,0,0,50"
                 Background="Transparent" />

          <!-- NativeControlHost added into VideoSurface in code-behind -->

          <!-- 暗色遮罩:暂停时半透明,恢复时透明 -->
          <Border Background="Black"
                  Opacity="{Binding DimOpacity}"
                  IsHitTestVisible="False" />

          <!-- 加载中提示 -->
          <Border IsVisible="{Binding IsLoading}"
                  Classes="glass"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="20,12">
            <TextBlock Text="{Binding StatusText}"
                       Classes="body"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>

          <!-- 暂停图标(中央圆形按钮) -->
          <Border IsVisible="{Binding IsPausedOverlay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Background="#8C000000"
                  BorderBrush="#40FFFFFF"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusFull}"
                  Width="{DynamicResource PlayerPauseIndicatorSize}"
                  Height="{DynamicResource PlayerPauseIndicatorSize}">
            <TextBlock Text="⏸"
                       FontSize="40"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <!--
            ===== 控制层(紧贴画面下沿) =====
            占据 VideoSurface 让出的高度,而不是叠在画面上——
            原生视频视图无法被 Avalonia 内容覆盖(框架未提供层级控制 API)。
          -->
          <Grid x:Name="ControlBar"
                VerticalAlignment="Bottom"
                Height="50">

            <!--
              渐变背景:从完全透明过渡到半透明黑,让白色控件在明亮画面上仍然可读。
              只随控制栏显隐,不做命中测试(否则会挡住视频区的点击)。
            -->
            <Border Opacity="{Binding ControlBarOpacity}"
                    IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#66000000" Offset="0.45" />
                  <GradientStop Color="#CC000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <Grid RowDefinitions="*,Auto">
              <!-- ==== 按钮行(随控制栏显隐) ==== -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                    Margin="14,0,14,2"
                    VerticalAlignment="Center"
                    Opacity="{Binding ControlBarOpacity}">
                <Grid.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                  </Transitions>
                </Grid.Transitions>

                <!-- 播放 / 暂停 -->
                <Button Grid.Column="0"
                        Classes="player"
                        Width="32" Height="32"
                        FontSize="13"
                        Command="{Binding TogglePlayPauseCommand}"
                        Content="{Binding PlayPauseGlyph}" />

                <!-- 标题 + 时间(标题占剩余宽度并自动截断) -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="*,Auto,Auto"
                      Margin="12,0,8,0"
                      VerticalAlignment="Center">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Title}"
                             Foreground="#D9FFFFFF"
                             FontSize="13"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Classes="playerTime"
                             Margin="10,0,0,0"
                             Text="{Binding PositionText}" />
                  <TextBlock Grid.Column="2"
                             Classes="playerTime"
                             Foreground="#80FFFFFF"
                             Text="{Binding DurationText, StringFormat=' / {0}'}"
                             IsVisible="{Binding HasDuration}" />
                </Grid>

                <!-- 倍速 -->
                <Button Grid.Column="2"
                        Classes="player"
                        Width="46" Height="32"
                        FontSize="12"
                        Content="{Binding PlaybackRateText}"
                        Command="{Binding CycleRateCommand}"
                        ToolTip.Tip="切换播放速度" />

                <!-- 音量 / 静音 -->
                <Button Grid.Column="3"
                        Classes="player"
                        Width="32" Height="32"
                        FontSize="13"
                        Content="{Binding VolumeGlyph}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip.Tip="静音 / 恢复(↑↓ 调节音量)" />

                <!-- 全屏 -->
                <Button Grid.Column="4"
                        Classes="player"
                        Width="32" Height="32"
                        FontSize="13"
                        Content="⛶"
                        Command="{Binding ToggleFullscreenCommand}"
                        ToolTip.Tip="全屏(F)" />

                <!-- 关闭 -->
                <Button Grid.Column="5"
                        Classes="player"
                        Width="32" Height="32"
                        FontSize="13"
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="关闭(Esc)" />
              </Grid>

              <!--
                ==== 进度条 ====
                始终可见、不参与显隐:控制栏隐藏后,画面上只留这一条贴在最下方,
                用户仍能一眼看到播放进度。
                放在 Grid 的独立行而不是 StackPanel 里,是为了保证它有确定的 3px 高度——
                StackPanel 会把子元素压成内容高度,细进度条会因此渲染不出来。
              -->
              <Grid Grid.Row="1" x:Name="ProgressTrack" Height="3">
                <Border Background="#4DFFFFFF" />
                <Border x:Name="ProgressFill"
                        Background="#00A1D6"
                        HorizontalAlignment="Left"
                        Width="0" />
              </Grid>
            </Grid>

            <!-- HUD:操作反馈,居中在控制层上方(同受"原生视图在下"的支撑才能显示) -->
            <Border IsVisible="{Binding IsHudVisible}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,8"
                    Background="#CC000000"
                    CornerRadius="8"
                    Padding="16,10"
                    IsHitTestVisible="False">
              <TextBlock Text="{Binding HudText}"
                         Foreground="#FFFFFFFF"
                         FontSize="17"
                         FontWeight="SemiBold" />
            </Border>
          </Grid>

          <!--
            标题不再悬浮在画面上:原生视频视图无法被 Avalonia 内容覆盖,
            悬浮标题会被视频盖住而完全看不见。改为放进控制栏左侧(见下方按钮行),
            既不占用额外高度,也始终可读。
          -->
        </Panel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
