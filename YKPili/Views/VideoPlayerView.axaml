<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YKPili.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="YKPili.Views.VideoPlayerView"
             x:DataType="vm:VideoPlayerViewModel"
             IsVisible="{Binding IsVisible}">

  <!--
    播放器布局:
      Overlay(全屏遮罩) - 整个浮层
      Panel(900x550 玻璃面板) - 实际播放区域
        - Title Bar: 顶部标题 + 关闭按钮
        - Video Area: 中间视频区域,NativeControlHost 在代码后台插入
        - Bottom Bar: 底部播放/暂停按钮

    设计说明:
      面板使用 glass / elevated 样式类(见 Styles/Controls/GlassSurface.axaml),
      标题栏与底栏保持透明并改用 1px 分隔线划分区域——
      这样玻璃质感可以贯穿整个面板,而不是被两块实色条切断。

    注意:
      Panel / VideoArea / Overlay 三个 x:Name 被 VideoPlayerView.axaml.cs 引用
      (原生播放器宿主定位依赖它们),布局尺寸与内边距的改动需重新验证原生视图贴合。
  -->
  <Grid x:Name="Overlay"
        Background="{DynamicResource OverlayScrim}"
        IsVisible="{Binding IsVisible}">

    <Border x:Name="Panel"
            Classes="glass elevated on-content"
            Width="{DynamicResource PlayerPanelWidth}"
            Height="{DynamicResource PlayerPanelHeight}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0"
                Padding="16,12"
                CornerRadius="{DynamicResource CornerTopOnly}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}"
                       Classes="title"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Content="✕"
                    Width="32" Height="32"
                    FontSize="14"
                    Command="{Binding CloseCommand}" />
          </Grid>
        </Border>

        <!-- ===== 视频区域:NativeControlHost 会在代码后台被插入到 Children[0] ===== -->
        <Panel Grid.Row="1"
               x:Name="VideoArea"
               Background="Transparent">

          <!-- NativeControlHost added at index 0 in code-behind -->

          <!-- 暗色遮罩:暂停时半透明,恢复时透明 -->
          <Border Background="Black"
                  Opacity="{Binding DimOpacity}"
                  IsHitTestVisible="False" />

          <!-- 加载中提示 -->
          <Border IsVisible="{Binding IsLoading}"
                  Classes="glass"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="20,12">
            <TextBlock Text="{Binding StatusText}"
                       Classes="body"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>

          <!-- 暂停图标(中央圆形按钮) -->
          <Border IsVisible="{Binding IsPausedOverlay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Background="{DynamicResource OverlayScrim}"
                  BorderBrush="{DynamicResource BorderPopover}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusFull}"
                  Width="{DynamicResource PlayerPauseIndicatorSize}"
                  Height="{DynamicResource PlayerPauseIndicatorSize}">
            <TextBlock Text="⏸"
                       FontSize="40"
                       Foreground="{DynamicResource TextOnAccent}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>

          <!--
            原先此处有一圈 Lime 绿色调试边框用于定位 NativeControlHost 区域,
            换肤后移除——调试标识不应出现在成品外观中。
          -->
        </Panel>

        <!-- ===== 底部控制栏 ===== -->
        <Border Grid.Row="2"
                Padding="12,10"
                CornerRadius="{DynamicResource CornerBottomOnly}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="{DynamicResource Space2}">
            <Button Classes="accent"
                    Width="{DynamicResource PlayerTransportButtonWidth}"
                    Height="{DynamicResource PlayerTransportButtonHeight}"
                    FontSize="16"
                    Command="{Binding TogglePlayPauseCommand}"
                    Content="⏯" />
          </StackPanel>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
