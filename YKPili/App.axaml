<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:YKPili"
             x:Class="YKPili.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant 跟随系统主题;"Dark" 或 "Light" 则是强制指定固定主题。 -->

    <!-- 全局资源:设计 Token 层(分层说明见 Styles/Theme.axaml) -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://YKPili/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- 数据模板集合:注册自定义 ViewLocator,根据 ViewModel 类型自动匹配对应 View -->
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!--
      应用全局样式。
      顺序很关键:FluentTheme 必须最先,自定义样式紧随其后才能覆盖它的默认外观。
    -->
    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://YKPili/Styles/Controls/GlassSurface.axaml" />
        <StyleInclude Source="avares://YKPili/Styles/Controls/TextStyles.axaml" />
        <StyleInclude Source="avares://YKPili/Styles/Controls/ButtonStyles.axaml" />
        <StyleInclude Source="avares://YKPili/Styles/Controls/ScrollBarStyles.axaml" />
    </Application.Styles>
</Application>
